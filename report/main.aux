\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Lorenz attractor with initial state (1.0,1.0,1.0) and time step (0.001, 0.01, 0.1), and total simulation time of 40 seconds, For $\Delta t > 0.01$, the solution is not stable enough to reliably reproduce the attractor shape.}}{10}{}\protected@file@percent }
\newlabel{fig:lorenz_vis}{{1}{10}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Lorenz attractor error analysis with initial state (1.0,1.0,1.0) and time step (0.001, 0.01, 0.1), and total simulation time of 40 seconds, For $\Delta t > 0.01$, the solution is not stable enough to reliably reproduce the attractor shape.}}{11}{}\protected@file@percent }
\newlabel{fig:error_comparison1.1.4}{{2}{11}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Lorenz attractor error analysis with initial state \((1.0, 1.0, 1.0)\), 1000 different time steps between \((0.0001 and 0.001)\), and a total simulation time of 40 seconds. this experiment is to compare the mean error of the two methods.}}{12}{}\protected@file@percent }
\newlabel{fig:error_comparison_same_times}{{3}{12}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Lorenz attractor error analysis with initial state \((1.0, 1.0, 1.0)\), using 1000 different time steps between \(10^{-3}\) and \(10^{-1}\), and a total simulation time of 40 seconds. For \(\Delta t > 0.025\), the Euler solution is not stable enough to reliably reproduce the attractor shape.}}{13}{}\protected@file@percent }
\newlabel{fig:lorenz_error1000}{{4}{13}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Lorenz attractor error analysis with initial state \((1.0, 1.0, 1.0)\), using 100 different time steps between \(10^{-3}\) and \(10^{1}\), and a total simulation time of 40 seconds. For \(\Delta t < 0.14\), the RK4 solution is stable enough to reproduce the attractor shape.}}{14}{}\protected@file@percent }
\newlabel{fig:error_comparison_rk4_stable_0.13}{{5}{14}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Trade-off between time step size $\Delta t$, numerical error, and computational cost in the RK4 method. The error decreases as $\Delta t$ becomes smaller (\( \propto \Delta t^4 \)), while the cost increases (\( \propto 1\div \Delta t \)). The product of error and cost, representing a total efficiency metric, is minimized near \( \Delta t = 0.01 \), indicating an optimal balance between accuracy and performance for simulating the Lorenz system.}}{15}{}\protected@file@percent }
\newlabel{fig:error_trade_off_1_2_1}{{6}{15}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Comparison between reference system with \(\Delta t = 0.001\) and a less computationally expensive system with step size of \(\Delta t = 0.01\)}}{16}{}\protected@file@percent }
\newlabel{fig:0_001_lorenz_3d}{{7}{16}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Comparison between reference system with \(\Delta t = 0.001\) and a less computationally expensive system with step size of \(\Delta t = 0.0073\), for this I used Optuna \cite  {akiba2019optuna} with 50 trials. as we can see this has a lower error than the previous one attempt with \(\Delta t = 0.01\). with the time step of \(\Delta t = 0.0073\) we have \((40 \div 0.0073 = 5479)\), with the time step of \(\Delta t = 0.01\) we have \((40 \div 0.01 = 4000)\) steps.}}{16}{}\protected@file@percent }
\newlabel{fig:optuna_lorenz_3d}{{8}{16}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Comparison between two similar initial conditions of (0.01, 2.0, 1.0) and (0.1, 2.0, 1.0) and the time steps of $\Delta t = 0.01$ to show the chaotic behavior of the system.}}{17}{}\protected@file@percent }
\newlabel{fig:two_initial_conditions_3d_separate}{{9}{17}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Comparison between two similar initial conditions of (0.0, 2.0, 1.0) and (0.1, 2.0, 1.0) and the time steps of $\Delta t = 0.01$ to show the chaotic behavior of the system.}}{17}{}\protected@file@percent }
\newlabel{fig:two_initial_conditions_3d_separate_2}{{10}{17}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Comparison between two similar initial conditions of (1.0, 1.0, 1.0) and (1.0001, 1.0, 1.0) and the time steps of$\Delta t = 0.01$ to show the chaotic behavior of the system.}}{18}{}\protected@file@percent }
\newlabel{fig:two_initial_conditions_3d_separate_3}{{11}{18}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Simulation of a prey-predator system with the following initial settings: \texttt  {Environment(shape=[60,60], growrate=60, maxgrass=50, startgrass=1)}, \texttt  {Nrabbits = 200}, \texttt  {Nfoxes = 15}. Rabbits are initialized with \texttt  {speed=1}, \texttt  {vision=5}, \texttt  {breedfreq=10}, \texttt  {breedfood=10}, and \texttt  {maxage=40}. Foxes are initialized with \texttt  {speed=3}, \texttt  {vision=7}, \texttt  {breedfreq=30}, \texttt  {breedfood=20}, and \texttt  {maxage=80}.}}{18}{}\protected@file@percent }
\newlabel{fig:Ecolab_pred_prey}{{12}{18}{}{}{}}
